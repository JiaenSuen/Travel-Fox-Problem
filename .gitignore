# Python / test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and machine-specific runtime state
.venv/
venv/
env/
.conda/
.env
.env.*
!.env.example
config/runtime.local.json
config/*private*.json
*.local.json

# Credentials / secrets / private keys
.secrets/
secrets/
private/
private_data/
local_data/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
service-account*.json
secrets*.json
auth*.json
*api_key*
*apikey*
*access_token*
*refresh_token*

# Learned weights and exported inference engines
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.trt
checkpoints/**
!checkpoints/.gitkeep

# Experiment outputs: keep generated README/summary only
results/**
!results/.gitkeep
!results/*/
!results/*/README.md
!results/*/summary.png

# Evaluation media / recordings
videos/**
!videos/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v

# Logs / temporary exports / crash dumps
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.dmp
core
core.*

# OS / editor metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace
